{
  "name": "blueink/blueink-client-php",
  "description": "A PHP client library for the BlueInk eSignature REST API",
  "license": "MIT",
  "type": "library",
  "homepage": "https://github.com/blueinkhq/blueink-client-php",
  "keywords": ["esignature", "e-signature", "blueink", "sdk", "guzzle"],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.8",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "Blueink\\ClientSDK\\": "src/blueink/"
    },
    "classmap": [
      "src/blueink/"
    ],
    "files": [
      "src/blueink/constants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Blueink\\ClientSDK\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable"
}
